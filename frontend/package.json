  },
  "dependencies": {
    "next": "16.4.0",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.10",
    "typescript": "^5.9"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
