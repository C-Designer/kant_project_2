# Generate local database/signing credentials with: uv run python scripts/local_db.py
LC_DATABASE_URL=postgresql+psycopg://lovecode:CHANGE_ME@127.0.0.1:55439/lovecode
LC_TEST_DATABASE_URL=postgresql+psycopg://lovecode:CHANGE_ME@127.0.0.1:55439/lovecode_test
LC_SIGNING_KEY=GENERATE_AT_LEAST_32_RANDOM_BYTES
# Web API calls require explicit real-analysis enablement and user consent.
LC_PROVIDER=openai
LC_API_ENABLED=false
LC_API_KEY=
LC_MODEL=
LC_DEMO_ENABLED=true
LC_SHARE_SAVE_ENABLED=true
LC_RATE_LIMIT_ENABLED=true

# Actual user requests: requires BOTH switches + key/model, stays off until configured.
LC_REAL_ANALYSIS_ENABLED=false
# openai: whole 16-type classification + explanation (up to 2 calls/request).
# local: operator-owned trained classifier + OpenAI explanation (1 call/request).
LC_CLASSIFIER_MODE=openai
LC_MODELS_DIR=artifacts/models/comparison-v1
LC_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
# Per process, UTC day, counts attempts including failures. Restart resets this counter.
LC_DAILY_ANALYSIS_LIMIT=20
# Next server-only build setting; use backend service address for separate hosts.
API_INTERNAL_ORIGIN=http://127.0.0.1:8100
